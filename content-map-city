<script>

document.addEventListener('DOMContentLoaded', function() {
    // Ładujemy map-utils.js
    var utilsScript = document.createElement('script');
    utilsScript.src = "https://mapa.wirtualneszlaki.pl/app/js/map-utils.js?2024-10-11-18-42-15";
    utilsScript.onload = function() {
        // Po załadowaniu map-utils.js, ładujemy mapa.js
        var mapaScript = document.createElement('script');
        mapaScript.src = "https://mapa.wirtualneszlaki.pl/app/js/mapa.js?2024-10-25-16-43-49";
        mapaScript.onload = function() {
            // Po zakończeniu ładowania mapa.js, ładowanie init.js
            var initScript = document.createElement('script');
            initScript.src = "{$bat.theme}/js/init.js?2024-10-11-18-42-24";
            document.body.appendChild(initScript);
        };
        document.body.appendChild(mapaScript);
    };
    document.body.appendChild(utilsScript);
});


</script>
